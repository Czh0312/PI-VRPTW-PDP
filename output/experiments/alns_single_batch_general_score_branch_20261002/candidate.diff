+            if kind == 'p':
+                pickup_ready = delivered.get(order.id, order.delivery_window[0]+order.service_time)+order.min_use_time
+                if pickup_ready > current:
+                    current = pickup_ready
+            lateness = current-due
+            late += lateness if lateness > 0 else 0
+            current += order.service_time
+            if kind == 'd':
+                delivered[order.id] = current
+            distance += distance_to(previous, order.customer)
+            previous = order.customer
+            weight += w if kind == 'p' else -w
+            volume += vol if kind == 'p' else -vol
+            excess = weight-weight_cap
