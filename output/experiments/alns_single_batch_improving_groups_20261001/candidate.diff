+def _route_group_assignment(problem, current, incumbent, rng):
+    """Rank whole-route customer transfers by directed access arcs only.
+
+    The ranking is a proposal heuristic. Projection, full decoding and audit
+    still determine feasibility and the actual objective of a new partition.
+    """
+    groups = []
+    for trip in incumbent['e2_trips']:
+        events, source = trip['events'], trip['satellite_id']
+        if not events or any(e['kind'] != 'd' for e in events):
+            continue
+        customers = tuple(dict.fromkeys(problem.order_map[e['order_id']].customer for e in events))
+        if len(customers) < 2 or any(current[c] != source for c in customers):
+            continue
+        first = problem.order_map[events[0]['order_id']].customer
+        last = problem.order_map[events[-1]['order_id']].customer
+        groups.append((source, customers, first, last))
+    if not groups or len(problem.satellites) < 2:
+        return None
+    options = []
+    for source, customers, first, last in groups:
+        old = problem.distance(source, first)+problem.distance(last, source)
+        for target in problem.satellites:
+            if target != source:
+                delta = problem.distance(target, first)+problem.distance(last, target)-old
+                if delta < 0:
+                    options.append((delta, customers, target))
+    if not options:
+        # Preserve the original proposal RNG when every route transfer has a
+        # non-improving access component. No geometric score proves feasibility.
+        return None
+    options.sort(key=lambda option: option[0])
+    _, customers, target = rng.choice(options[:3])
+    candidate = dict(current)
+    for customer in customers:
+        candidate[customer] = target
+    return candidate
+
+
