# Track datasets, current outputs/results, and solver logs.

# Third-party source files are downloaded locally and are not redistributed.
data/real_case/raw/**/*.parquet
data/real_case/raw/**/*.xlsx

# Caches and dependencies
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
node_modules/

# Local configuration
.env
.env.*
!.env.example
!.env.template
.idea/
.vscode/
/.claude/
/.codex/
/.worktrees/
.DS_Store
Thumbs.db
Desktop.ini

# Regenerable build and temporary files
build/
dist/
*.egg-info/
*.tmp
*.temp
*.bak*
*.orig
*.rej
*.sw?
*~
*.inspect.ndjson
*.node
*.nodefile

# Obsolete historical results; keep their documentation.
/archive/*/*
!/archive/*/README.md
!/archive/experiments/
!/archive/experiments/**
!/archive/tests/
!/archive/tests/**
!/archive/docs/
!/archive/docs/**
!/archive/models/
!/archive/models/**
!/archive/reference/
!/archive/reference/README.md
