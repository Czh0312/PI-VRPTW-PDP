# Track datasets, current outputs/results, and solver logs.

# Third-party source files are downloaded locally and are not redistributed.
data/real_case/raw/**/*.parquet
data/real_case/raw/**/*.xlsx

# Private OSF raw records and downloaded paper copies stay local.
/data/real_case/raw/topanga_study7/
/reference/novelty_fulltexts_20261004/*.pdf
/output/literature_audit_20261004/fulltexts/
/output/literature_audit_20261004/extracted/
/output/literature_audit_20261004/rendered/
/output/literature_audit_20261004/sources/

# Caches and dependencies
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
node_modules/
/output/tmp/topanga_python_deps/
/output/tmp/model_comparison_builder/
/output/.model6_runtime/

# Each benchmark phase keeps one byte-identical frozen source tree.
# Per-run copies are recoverable with tools/data/restore_benchmark_sources.py.
/output/experiments/m1_m4_comparison_20261004/*/*/source_snapshot/
/output/experiments/m5_comparison_20261004/*/*/source_snapshot/
/output/economic_recalculation_20261005/lade_runs/*/source_snapshot/

# Model6 per-run sources are indexed by byte-identical shared source versions.
# Restore these copies with tools/data/restore_model6_sources.py.
/output/model6_comparison/*/*/source_snapshot/

# Local configuration
# Machine-local runtime helpers must also stay out of frozen experiment exports.
/output/model35678_comparison/**/source_snapshot/tools/project_runtime.py
.env
.env.*
!.env.example
!.env.template
.idea/
.vscode/
/.claude/
/.codex/
/.worktrees/
.DS_Store
Thumbs.db
Desktop.ini

# Unassigned command-line startup log; keep formal per-experiment logs tracked.
/gurobi.log

# Regenerable build and temporary files
build/
dist/
*.egg-info/
*.tmp
*.temp
*.bak*
*.orig
*.rej
*.sw?
*~
*.inspect.ndjson
*.node
*.nodefile

# Obsolete historical results; keep their documentation.
/archive/*/*
!/archive/*/README.md
!/archive/experiments/
!/archive/experiments/**
!/archive/config/
!/archive/config/**
!/archive/tests/
!/archive/tests/**
!/archive/docs/
!/archive/docs/**
!/archive/models/
!/archive/models/**
!/archive/reference/
!/archive/reference/README.md

# Exact copies of these oversized experiment artifacts are stored in
# output/large_artifacts/; restore with tools/data/restore_large_artifacts.py.
/output/experiments/m5_route_timing_20261001/probe_2.json
/output/experiments/m5_timed_integrality_20261001/probe_profile_models/joint/joint_inventory.mps.gz
